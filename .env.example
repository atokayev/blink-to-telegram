# Local development copy of the configuration.
# Production uses /etc/blink-to-telegram/env instead.
TELEGRAM_BOT_TOKEN=123456789:REPLACE_WITH_YOUR_TOKEN
TELEGRAM_CHAT_ID=-1001234567890
TELEGRAM_SILENT=false

BLINK_LOGIN_FILE=./data/blink_login.json
BLINK_DATA_DIR=./data

TZ=UTC
PYTHONDONTWRITEBYTECODE=1
MAX_FILE_MB=49
MAX_CLIPS_PER_RUN=50
SEND_DELAY_SECONDS=4
RETENTION_DAYS=90
LOG_LEVEL=INFO
DRY_RUN=false
