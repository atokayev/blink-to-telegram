# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=123456789:REPLACE_WITH_YOUR_TOKEN
# Channel numeric id (starts with -100) or @public_channel_name.
TELEGRAM_CHAT_ID=-1001234567890
TELEGRAM_SILENT=false

# Written by `blink-login`; keep this on persistent storage.
BLINK_LOGIN_FILE=/var/lib/blink-to-telegram/blink_login.json

# State database, archive, and temporary downloads.
BLINK_DATA_DIR=/var/lib/blink-to-telegram

# Caption timezone (IANA name).
TZ=UTC
# The app lives in a root-owned directory; do not try to write .pyc files there.
PYTHONDONTWRITEBYTECODE=1

# Bot API uploads are capped at 50 MB. 49,000,000 bytes leaves headroom.
MAX_FILE_MB=49
# Per-run cap; the rest of the backlog is drained on later runs.
MAX_CLIPS_PER_RUN=50
# Seconds between uploads. Telegram channels allow roughly 20 messages/minute.
SEND_DELAY_SECONDS=4
# Delete archived MP4s older than this many days (0 = keep forever).
RETENTION_DAYS=90
LOG_LEVEL=INFO
DRY_RUN=false
